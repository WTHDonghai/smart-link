# ════════════════════════════════════════════════════════════════════
# 美团 eBooking 待处理订单列表（美团商旅 MEITUANBIZ 复用同一地址）
SMARTLINK_OTA_MEITUAN_ORDER_URL="https://eb.meituan.com/ebooking/orders#/unhandled"
# 抖音履约工作台待处理订单列表
SMARTLINK_OTA_DOUYIN_ORDER_URL=https://life.douyin.com/p/liteapp/fulfillment-workbench/hotel-book/list?status=waiting
# 携程 eBooking 订单列表
SMARTLINK_OTA_CTRIP_ORDER_URL=https://ebooking.ctrip.com/ebk/orders
# 同程 eBooking 订单列表
SMARTLINK_OTA_TONGCHENG_ORDER_URL=https://ebooking.ly.com/orders
# 飞猪订单列表
SMARTLINK_OTA_FLIGGY_ORDER_URL=https://hotel.fliggy.com/orders
# 去哪儿订单列表
SMARTLINK_OTA_QUNAR_ORDER_URL=https://ebooking.qunar.com/orders

# ════════════════════════════════════════════════════════════════════
# Agent 模型运行配置（主进程静默读取；密钥不进入界面与日志）
# 两项功能开关默认关闭；任一开启后，缺失必要项将在功能启动时报错列明缺失键
# ════════════════════════════════════════════════════════════════════
# 产品自动映射开关：采集到 OTA 产品后自动填写房型/房价码/预订类型三项映射草稿
# SMARTLINK_AGENT_PRODUCT_MAPPING_ENABLED=false
# 值守异常诊断开关：值守任务失败后自动只读观察页面、模型诊断并推送群通知
# SMARTLINK_AGENT_EXCEPTION_RECOVERY_ENABLED=false
# 模型供应商标识（openai / deepseek / qwen 等 OpenAI 兼容供应商）
# SMARTLINK_AGENT_MODEL_PROVIDER=openai
# 模型服务 Base URL（含版本路径的完整前缀，如 https://api.deepseek.com/v1）
# SMARTLINK_AGENT_MODEL_BASE_URL=https://api.example.com/v1
# 供应商 API 密钥（仅主进程读取；严禁写入日志、报错与界面）
# SMARTLINK_AGENT_MODEL_API_KEY=
# 产品自动映射使用的模型版本
# SMARTLINK_AGENT_MAPPING_MODEL=
# 异常诊断使用的模型版本
# SMARTLINK_AGENT_DIAGNOSIS_MODEL=
# 单次模型请求超时毫秒数（默认 30000）
# SMARTLINK_AGENT_MODEL_TIMEOUT_MS=30000
# 并发模型请求上限（默认 2）
# SMARTLINK_AGENT_MODEL_MAX_CONCURRENCY=2

# ════════════════════════════════════════════════════════════════════
# Agent 值守消息通知（群机器人 webhook；地址含密钥仅主进程读取，不入日志）
# WEBHOOK_TYPE: wecom=企业微信 | dingtalk=钉钉 | feishu=飞书
# ════════════════════════════════════════════════════════════════════
# 通知开关：开启后 WEBHOOK_TYPE 与 WEBHOOK_URL 变为必填
# SMARTLINK_AGENT_NOTIFY_ENABLED=false
# 群机器人类型（wecom=企业微信 | dingtalk=钉钉 | feishu=飞书）
# SMARTLINK_AGENT_NOTIFY_WEBHOOK_TYPE=wecom
# 群机器人完整 webhook 地址（必须为 https）
# SMARTLINK_AGENT_NOTIFY_WEBHOOK_URL=
# 钉钉「加签」安全设置的密钥（仅钉钉机器人需要，其余渠道留空）
# SMARTLINK_AGENT_NOTIFY_DINGTALK_SECRET=
# 通知请求超时毫秒数（默认 10000）
# SMARTLINK_AGENT_NOTIFY_TIMEOUT_MS=10000

# ════════════════════════════════════════════════════════════════════
# 系统与自动化运行时（可选；缺省即适用常规桌面运行）
# ════════════════════════════════════════════════════════════════════
# 自动化浏览器无头模式：true 时不显示浏览器窗口（默认 false 有头，便于现场人工接管验证）
# PLAYWRIGHT_HEADLESS=false
# 浏览器 Profile 与工位身份数据目录覆盖（容器化/多实例隔离时使用；缺省用系统标准用户数据目录）
# SMARTLINK_USER_DATA_DIR=
