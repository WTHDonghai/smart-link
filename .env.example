# ════════════════════════════════════════════════════════════════════
# 文旅平台（中台/PMS）网关
# ════════════════════════════════════════════════════════════════════
# 中台业务 API 基址：登录鉴权、渠道/酒店映射、订单导入、值守任务认领与回执均走此地址
# 开发环境 (开发联调): https://xctp-api.devops.foxhis.com
# 生产环境 (现场交付/标准服务): https://pms-api.xiruan.com
SMARTLINK_PLATFORM_BASE_URL=https://xctp-api.dev.foxhis.com

# ════════════════════════════════════════════════════════════════════
# OTA 渠道商家中心与门店采集地址（产品/门店采集浏览器会话打开的页面）
# ════════════════════════════════════════════════════════════════════
# 美团酒店商家中心（产品采集与值守共用浏览器会话）
SMARTLINK_OTA_MEITUAN_URL=https://me.meituan.com/ebooking/merchant/product/batch-price
# 美团商旅商家中心（与美团共用会话；未配置时回退美团地址）
SMARTLINK_OTA_MEITUAN_BIZ_URL=https://me.meituan.com/ebooking/merchant/product/batch-price
# 抖音生活服务经营管理后台
SMARTLINK_OTA_DOUYIN_URL=https://life.douyin.com/p/poi-manage/home
# 携程 eBooking 商家中心
SMARTLINK_OTA_CTRIP_URL=https://ebooking.ctrip.com/
# 同程 eBooking 商家中心
SMARTLINK_OTA_TONGCHENG_URL=https://ebooking.ly.com/
# 飞猪酒店商家中心
SMARTLINK_OTA_FLIGGY_URL=https://hotel.fliggy.com/
# 去哪儿 eBooking 商家中心
SMARTLINK_OTA_QUNAR_URL=https://ebooking.qunar.com/
# 小红书专业号经营后台
SMARTLINK_OTA_RED_URL=https://ark.xiaohongshu.com/

