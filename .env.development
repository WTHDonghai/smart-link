# ════════════════════════════════════════════════════════════════════
# Agent 模型运行配置（主进程静默读取；密钥不进入界面与日志）
# 两项功能开关默认关闭；任一开启后，缺失必要项将在功能启动时报错列明缺失键
# ════════════════════════════════════════════════════════════════════
# 产品自动映射开关：采集到 OTA 产品后自动填写房型/房价码/预订类型三项映射草稿
SMARTLINK_AGENT_PRODUCT_MAPPING_ENABLED=true
# 值守异常诊断开关：值守任务失败后自动只读观察页面、模型诊断并推送群通知
SMARTLINK_AGENT_EXCEPTION_RECOVERY_ENABLED=true
# 模型供应商标识（openai / deepseek / qwen 等 OpenAI 兼容供应商）
SMARTLINK_AGENT_MODEL_PROVIDER=openai

# 模型服务 Base URL（含版本路径的完整前缀，如 https://api.deepseek.com/v1）
# 注意：必须使用 OpenAI 兼容端点（客户端按 {BASE_URL}/chat/completions 调用）；/apps/anthropic 为 Anthropic 协议代理，实测 404
SMARTLINK_AGENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 供应商 API 密钥（仅主进程读取；严禁写入日志、报错与界面）
# 密钥不入库:真实值放在 .env.development.local(已 gitignore),此处保持注释占位
# SMARTLINK_AGENT_MODEL_API_KEY=

# 产品自动映射使用的模型版本
SMARTLINK_AGENT_MAPPING_MODEL=qwen3.8-flash
# 异常诊断使用的模型版本
SMARTLINK_AGENT_DIAGNOSIS_MODEL=qwen3.8-flash
# 单次模型请求超时毫秒数（默认 30000）
# qwen3.8-flash 为思考型模型，映射 prompt 实测耗时 23~30s+（2026-11-09 日志：23.4s 成功、30s 超时各一次）
# 超时须覆盖思考耗时波动，默认 30s 不够用
SMARTLINK_AGENT_MODEL_TIMEOUT_MS=120000
# 并发模型请求上限（默认 2）
# SMARTLINK_AGENT_MODEL_MAX_CONCURRENCY=2


# ── Agent 值守消息通知（开发环境；手工填写后取消注释） ──
# SMARTLINK_AGENT_NOTIFY_ENABLED=false
# SMARTLINK_AGENT_NOTIFY_WEBHOOK_TYPE=wecom
# SMARTLINK_AGENT_NOTIFY_WEBHOOK_URL=
# SMARTLINK_AGENT_NOTIFY_DINGTALK_SECRET=
# SMARTLINK_AGENT_NOTIFY_TIMEOUT_MS=10000
